{
  "name": "jarvis-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "Full-screen JARVIS-style launcher that sits on top of Windows.",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n vite,tsc,app -c cyan,yellow,green \"vite\" \"tsc -p tsconfig.main.json --watch --preserveWatchOutput\" \"wait-on tcp:127.0.0.1:5173 dist/main/index.js dist/preload/index.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -p tsconfig.main.json && vite build",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.mario.jarvis-launcher",
    "productName": "Jarvis Launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "assets/icon.png",
      "assets/wake/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "assets/wake/**",
      "node_modules/onnxruntime-node/**"
    ],
    "icon": "assets/icon.png",
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Jarvis Launcher",
      "artifactName": "JarvisLauncher-Setup.${ext}"
    },
    "portable": {
      "artifactName": "JarvisLauncher-portable.exe"
    }
  },
  "dependencies": {
    "onnxruntime-node": "^1.31.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.3.0",
    "@fontsource/share-tech": "^5.3.0",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.9",
    "wait-on": "^8.0.3"
  }
}
